# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

# VAPID keys
# generate with `bunx web-push generate-vapid-keys`
PUBLIC_VAPID_KEY=
VAPID_PRIVATE=

# minio
MINIO_URL=
MINIO_KEY=
MINIO_SECRET=
MINIO_BUCKET=
MINIO_PORT=9000
MINIO_USE_SSL=false
S3_REGION=us-east-1
# Optional object used by readiness checks. It does not need to exist.
S3_HEALTHCHECK_KEY=.buddycam-healthcheck

HOST_DOMAIN=buddycam.example.com
OUTPUT_DIR=/tmp/buddycam

# Optional error monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Only needed in CI when uploading source maps.
SENTRY_AUTH_TOKEN=

# Cloudflare Realtime TURN. Keep both values server-side and never prefix them with PUBLIC_.
CLOUDFLARE_TURN_TOKEN_ID=
CLOUDFLARE_TURN_API_TOKEN=
